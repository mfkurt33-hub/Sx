# ─────────────────────────────────────────────────────────────────────────────
# AiToManage — Environment Variables
# Kopyala: cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ═══════════════════════════════════════
# ZORUNLU — bunlar olmadan uygulama başlamaz
# ═══════════════════════════════════════

# MongoDB
MONGODB_URI=mongodb://localhost:27017/aitomanage
# Production örnek:
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/aitomanage?retryWrites=true

# Next.js
NEXTAUTH_SECRET=BURAYA_EN_AZ_32_KARAKTER_GIZLI_ANAHTAR
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Redis (BullMQ için zorunlu)
REDIS_URL=redis://localhost:6379

# NestJS Backend
NODE_ENV=development
BACKEND_PORT=3001
BACKEND_URL=http://localhost:3001


# ═══════════════════════════════════════
# AI SERVİSLERİ — Studio özelliği için zorunlu
# ═══════════════════════════════════════

# Replicate (birincil AI görsel işleme)
# Edinin: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# fal.ai (Replicate fallback)
# Edinin: https://fal.ai/dashboard/keys
FAL_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# OpenAI (caption ve metin üretimi için)
# Edinin: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic Claude (AI asistan için)
# Edinin: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ═══════════════════════════════════════
# ÖDEME — Türkiye için zorunlu
# ═══════════════════════════════════════

# iyzico (birincil ödeme sağlayıcısı)
# Edinin: https://sandbox.iyzipay.com
IYZICO_API_KEY=sandbox-xxxxxxxxxxxxxxxxxxxxxxxx
IYZICO_SECRET_KEY=sandbox-xxxxxxxxxxxxxxxxxxxxxxxx
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# Production: https://api.iyzipay.com

# Param (alternatif Türk ödeme sağlayıcısı)
PARAM_CLIENT_CODE=
PARAM_GUID=
PARAM_NAME=
PARAM_PASSWORD=

# Stripe (uluslararası ödemeler için opsiyonel)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ═══════════════════════════════════════
# SOSYAL MEDYA API'LARI
# ═══════════════════════════════════════

# Meta (Instagram + Facebook)
# Edinin: https://developers.facebook.com
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=RASTGELE_GIZLI_TOKEN

# Twitter/X
# Edinin: https://developer.twitter.com
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# LinkedIn
# Edinin: https://www.linkedin.com/developers
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Google (Google My Business için)
# Edinin: https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# WhatsApp Business API (Meta Cloud API)
# Edinin: https://developers.facebook.com/docs/whatsapp
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=RASTGELE_GIZLI_TOKEN


# ═══════════════════════════════════════
# E-POSTA
# ═══════════════════════════════════════

# SMTP (haftalık rapor ve bildirimler için)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@aitomanage.com
SMTP_PASS=
SMTP_FROM="AiToManage <noreply@aitomanage.com>"

# Resend (opsiyonel — daha güvenilir email servisi)
# Edinin: https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ═══════════════════════════════════════
# E-FATURA / GİB (yasal zorunluluk)
# ═══════════════════════════════════════

# e-Fatura servis sağlayıcısı (İzibiz, Logo, Paraşüt vb.)
EFATURA_PROVIDER=izibiz
EFATURA_USERNAME=
EFATURA_PASSWORD=
EFATURA_BASE_URL=https://efatura.izibiz.com.tr
# Test: https://efatura.izibiz.com.tr/test

# Fatura seri numarası prefix
INVOICE_SERIES=ATM


# ═══════════════════════════════════════
# DEPOLAMA
# ═══════════════════════════════════════

# AWS S3 (görsel ve dosya depolama)
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=aitomanage-uploads

# Cloudflare R2 (S3 alternatifi, daha ucuz egress)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=aitomanage-uploads
# R2_PUBLIC_URL=https://cdn.aitomanage.com


# ═══════════════════════════════════════
# MONITORING & LOGGING
# ═══════════════════════════════════════

# Sentry (hata takibi)
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Log seviyesi: error | warn | info | debug
LOG_LEVEL=info


# ═══════════════════════════════════════
# OPSİYONEL — gelişmiş özellikler
# ═══════════════════════════════════════

# Pusher veya Ably (gerçek zamanlı bildirimler)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=eu
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=eu

# Google Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Rate limiting (Redis tabanlı)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
